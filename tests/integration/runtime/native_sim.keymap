#include <behaviors.dtsi>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Test";
        transform = <&transform>;
        keys = <&key_physical_attrs 100 100 0 0 0 0 0>,
               <&key_physical_attrs 100 100 100 0 0 0 0>,
               <&key_physical_attrs 100 100 0 100 0 0 0>,
               <&key_physical_attrs 100 100 100 100 0 0 0>;
    };
    transform: transform {
        compatible = "zmk,matrix-transform";
        rows = <2>; columns = <2>;
        map = <RC(0,0) RC(0,1) RC(1,0) RC(1,1)>;
    };
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <&kp A &kp B &kp C &kp D>;
        };

        other {
            bindings = <&trans &trans &trans &trans>;
        };
    };

    /* Unit scale and no deadzone, so a displacement comes out as the same count. */
    padstick_runtime_test: stick_runtime {
        compatible = "zmk,input-processor-padstick";
        #input-processor-cells = <0>;
        x-deadzone = <0>;
        y-deadzone = <0>;
        x-scale = <256>;
        y-scale = <256>;
        x-accel-range = <0>;
        y-accel-range = <0>;
        max-x = <127>;
        max-y = <127>;



    };

    /*
     * Two idle sources and their listeners. They send nothing; they only make
     * sure the processor has at least two streams, which the self-tests drive
     * directly.
     */
    idle_source_a: idle_source_a {
        compatible = "zmk,input-mock";
        event-period = <100>;
        events = <>;
    };

    padstick_touch_passthrough: stick_pass {
        compatible = "zmk,input-processor-padstick";
        #input-processor-cells = <0>;
    };

    /* Actual input queue endpoint; acknowledgements are explicitly controlled. */
    repeat_sink: repeat_sink {
        compatible = "zmk,input-mock";
        event-period = <100>;
        events = <>;
    };

    idle_source_b: idle_source_b {
        compatible = "zmk,input-mock";
        event-period = <100>;
        events = <>;
    };

    idle_listener_a {
        compatible = "zmk,input-listener";
        device = <&idle_source_a>;
        input-processors = <&padstick_runtime_test>;
    };

    idle_listener_b {
        compatible = "zmk,input-listener";
        device = <&idle_source_b>;
        input-processors = <&padstick_runtime_test>;
    };
};

/* An empty mock exits at boot; one late press keeps the process up for the tests. */
&kscan {
    events = <ZMK_MOCK_PRESS(0,0,30000)>;
};
